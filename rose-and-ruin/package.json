{
  "name": "rose-and-ruin",
  "version": "1.0.0",
  "private": true,
  "description": "Rose & Ruin: a large-scale medieval knight battle game set at the castles of the Wars of the Roses.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:server": "node scripts/build-server.mjs",
    "build:standalone": "vite build && node scripts/build-standalone.mjs",
    "test": "node scripts/build-tests.mjs && node scripts/build-server.mjs && node dist-test/sim.test.mjs && node dist-test/net.test.mjs && node dist-test/predict.test.mjs"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@types/node": "^22.12.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
